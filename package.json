{
  "name": "mcpviews",
  "version": "0.2.65",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:update-test": "node scripts/dev-update-test.mjs",
    "build": "tauri build",
    "build:staging": "node scripts/mcpviews-lane.mjs build --staging",
    "build:mac-dev-bundle": "node scripts/build-mac-dev-bundle.mjs",
    "stage:mac-dev-bundle": "node scripts/build-mac-dev-bundle.mjs --stage-only",
    "prepare:windows-bundle-config": "node scripts/prepare-windows-bundle-config.mjs",
    "lane:status": "node scripts/mcpviews-lane.mjs status",
    "lane:prepare": "node scripts/mcpviews-lane.mjs prepare",
    "lane:prepare:staging": "node scripts/mcpviews-lane.mjs prepare --staging",
    "lane:stage-plugins:staging": "node scripts/mcpviews-lane.mjs stage-plugins --staging",
    "lane:setup": "node scripts/mcpviews-lane.mjs setup",
    "lane:setup:staging": "node scripts/mcpviews-lane.mjs setup --staging",
    "lane:install:staging": "node scripts/mcpviews-lane.mjs install --staging",
    "stage:branded-bundle": "node scripts/stage-branded-bundled-plugins.mjs",
    "verify:branded-bundle": "node scripts/stage-branded-bundled-plugins.mjs --verify-only",
    "plugins:channel:status": "node scripts/use-local-plugin-channel.mjs status",
    "plugins:channel:staging": "node scripts/use-local-plugin-channel.mjs staging",
    "plugins:channel:production": "node scripts/use-local-plugin-channel.mjs production",
    "plugins:envs:setup": "node scripts/use-local-plugin-channel.mjs named-envs",
    "plugins:envs:status": "node scripts/use-local-plugin-channel.mjs named-envs:status",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ai-debug-loop": "vitest run tests/tribex-ai-thread-debug-loop.test.js --reporter verbose",
    "debug:native-build": "node scripts/native-build-ui-debug-loop.mjs",
    "debug:ai-visual-loop": "node scripts/tribex-ai-visual-debug-loop.mjs",
    "debug:ai-browser-harness": "node scripts/tribex-ai-browser-harness-url.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "adm-zip": "^0.5.17",
    "happy-dom": "^20.10.6",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "agents": "^0.16.2"
  }
}
